generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  invites      Invite[]
}

model Invite {
  id        String         @id @default(cuid())
  userId    String
  slug      String         @unique
  template  InviteTemplate
  brideName   String?
  groomName   String?
  weddingDate DateTime?
  views       Int            @default(0)
  data        Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvps       Rsvp[]

  @@index([userId])
  @@index([updatedAt])
  @@index([weddingDate])
}

model Rsvp {
  id                 String   @id @default(cuid())
  inviteId           String
  name               String
  guestCount         Int      @default(1)
  attendanceTime     String
  needsAccommodation Boolean?
  phone              String?
  email              String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  invite             Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId])
  @@index([createdAt])
}

enum InviteTemplate {
  MINIMAL
  ROYAL
  HINDU
  MUSLIM
  CHRISTIAN
  SIKH
  CIVIL
  LUXURY
  SOUTH_INDIAN
}
